{
  "name": "web-app-e2e",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/web-app-e2e/src",
  "projectType": "application",
  "implicitDependencies": ["web-app"],
  "targets": {
    "e2e": {
      "executor": "nx:run-commands",
      "options": {
        "command": "playwright test -c apps/web-app-e2e/playwright.config.ts --project=chromium"
      },
      "configurations": {
        "headed": {
          "command": "playwright test -c apps/web-app-e2e/playwright.config.ts --project=chromium --headed --workers=1"
        },
        "debug": {
          "command": "playwright test -c apps/web-app-e2e/playwright.config.ts --project=chromium --debug --workers=1"
        },
        "ci": {
          "command": "playwright test -c apps/web-app-e2e/playwright.config.ts --project=chromium --reporter=line --workers=1"
        }
      }
    },
    "e2e-full": {
      "executor": "nx:run-commands",
      "options": {
        "command": "playwright test -c apps/web-app-e2e/playwright.config.ts"
      },
      "configurations": {
        "headed": {
          "command": "playwright test -c apps/web-app-e2e/playwright.config.ts --headed --workers=1"
        },
        "debug": {
          "command": "playwright test -c apps/web-app-e2e/playwright.config.ts --debug --workers=1"
        },
        "ci": {
          "command": "playwright test -c apps/web-app-e2e/playwright.config.ts --reporter=line --workers=1"
        }
      }
    },
    "e2e-ci": {
      "executor": "nx:run-commands",
      "options": {
        "command": "playwright test -c apps/web-app-e2e/playwright.config.ts --reporter=line"
      },
      "configurations": {
        "ci": {
          "command": "playwright test -c apps/web-app-e2e/playwright.config.ts --reporter=line --workers=1"
        }
      }
    },
    "e2e-preclean-dashboard": {
      "executor": "nx:run-commands",
      "options": {
        "command": "playwright test -c apps/web-app-e2e/playwright.config.ts --project=chromium"
      },
      "configurations": {
        "headed": {
          "command": "playwright test -c apps/web-app-e2e/playwright.config.ts --project=chromium --headed --workers=1"
        },
        "debug": {
          "command": "playwright test -c apps/web-app-e2e/playwright.config.ts --project=chromium --debug --workers=1"
        },
        "ci": {
          "command": "playwright test -c apps/web-app-e2e/playwright.config.ts --project=chromium --reporter=line --workers=1"
        }
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/web-app-e2e",
        "command": "eslint ."
      }
    },
    "e2e-bugs": {
      "executor": "nx:run-commands",
      "options": {
        "command": "playwright test -c apps/web-app-e2e/playwright.config.ts --project=bugs --workers=1"
      },
      "configurations": {
        "headed": {
          "command": "playwright test -c apps/web-app-e2e/playwright.config.ts --project=bugs --workers=1 --headed"
        },
        "debug": {
          "command": "playwright test -c apps/web-app-e2e/playwright.config.ts --project=bugs --workers=1 --debug"
        }
      }
    }
  },
  "tags": ["scope:e2e"]
}
